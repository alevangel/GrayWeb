{
  "name": "grayweb",
  "version": "1.0.0",
  "description": "Browser extension that shows selected websites in grayscale.",
  "license": "MIT",
  "author": "Alessandro Evangelista",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alevangel/GrayWeb.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs --target=all",
    "build:chromium": "node scripts/build.mjs --target=chromium",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "watch": "node scripts/build.mjs --target=chromium --watch",
    "package": "node scripts/build.mjs --target=all --zip",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "test:e2e": "playwright test",
    "lint:firefox": "npm run build:firefox && web-ext lint --source-dir dist/firefox",
    "start:firefox": "npm run build:firefox && web-ext run --source-dir dist/firefox",
    "watch:firefox": "node scripts/build.mjs --target=firefox --watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0"
  }
}
